<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="245dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_card"
    android:elevation="3dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/imgLogoFundacion"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#E4F1E9"
        android:contentDescription="Logo de fundación"
        android:padding="35dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:backgroundTint="#287A5A" />

    <TextView
        android:id="@+id/txtNombreFundacionItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre Fundación"
        android:textColor="#287A5A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/txtDescripcionFundacionItem"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Descripción de la labor de la fundación."
        android:textColor="#52645A"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:maxLines="3"
        android:ellipsize="end"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver fundación →"
        android:textColor="#287A5A"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>

</LinearLayout>
