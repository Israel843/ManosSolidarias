<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="112dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_card"
    android:elevation="3dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/imgLogoFundacion"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_surface_soft"
        android:contentDescription="Logo de fundación"
        android:padding="18dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:tint="@color/sh_primary"
        tools:ignore="UseAppTint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

    <TextView
        android:id="@+id/txtNombreFundacionItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre Fundación"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="0dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/txtDescripcionFundacionItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción de la labor de la fundación."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver fundación  →"
        android:textColor="@color/sh_primary"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="5dp"/>
    </LinearLayout>

</LinearLayout>
