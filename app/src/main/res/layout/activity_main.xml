<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_auth" android:fillViewport="true">
    <LinearLayout
        android:id="@+id/loginContent"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_horizontal" android:orientation="vertical"
        android:paddingHorizontal="28dp" android:paddingTop="24dp" android:paddingBottom="28dp">
        <ImageView
            android:id="@+id/imgLogo" android:layout_width="200dp" android:layout_height="180dp"
            android:contentDescription="Marca de Manos Solidarias" android:scaleType="centerCrop"
            android:src="@drawable/manos_solidarias_mark" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:gravity="center" android:lineSpacingExtra="-6dp"
            android:text="Manos\nSolidarias" android:textColor="@color/sh_primary_dark"
            android:textSize="39sp" android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Juntos podemos ayudar"
            android:textColor="@color/text_secondary" android:textSize="17sp" />
        <EditText
            android:id="@+id/edtUsuario" android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginTop="42dp" android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_mail" android:drawablePadding="14dp"
            android:hint="Correo electrónico" android:inputType="textEmailAddress"
            android:paddingHorizontal="18dp" android:singleLine="true"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="16sp" />
        <EditText
            android:id="@+id/edtContrasena" android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginTop="14dp" android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_lock" android:drawablePadding="14dp"
            android:drawableEnd="@drawable/ic_eye"
            android:hint="Contraseña" android:inputType="textPassword"
            android:paddingHorizontal="18dp" android:singleLine="true"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="16sp" />
        <Button
            android:id="@+id/btnIniciarSesion" android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginTop="28dp" android:background="@drawable/bg_button" android:backgroundTint="@color/sh_primary"
            android:elevation="3dp" android:text="Iniciar sesión" android:textAllCaps="false"
            android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/txtRegistrarse" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:clickable="true" android:focusable="true" android:padding="10dp"
            android:text="Crear una cuenta" android:textColor="@color/sh_coral_dark"
            android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
