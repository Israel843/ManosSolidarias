<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8F6"
    android:padding="18dp">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnVolverHistorial"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="@android:color/transparent"
            android:tint="#287A5A"
            android:contentDescription="Volver"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mi historial"
            android:textColor="#287A5A"
            android:textSize="24sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- CONTADOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="15dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Donaciones realizadas"
            android:textColor="#718096"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/txtTotalDonaciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 donaciones"
            android:textColor="#287A5A"
            android:textSize="23sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- TITULO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis donaciones"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#263C50"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="12dp"/>

    <!-- LISTA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/contenedorDonaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp"/>

        </ScrollView>

        <!-- ESTADO VACIO -->
        <LinearLayout
            android:id="@+id/contenedorVacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:src="@android:drawable/ic_menu_recent_history"
                android:tint="#287A5A"
                android:contentDescription="Historial vacío"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Todavía no tienes donaciones"
                android:textColor="#287A5A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tus donaciones aparecerán aquí."
                android:textColor="#718096"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
