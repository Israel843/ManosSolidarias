<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent"
    >

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/background" android:orientation="vertical">
        <ScrollView
            android:id="@+id/homeScroll" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/homeHeader"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="238dp"
                    android:background="@drawable/bg_hero" android:orientation="vertical"
                    android:paddingHorizontal="24dp" android:paddingTop="14dp" android:paddingBottom="30dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageButton
                            android:id="@+id/btnMenu" android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@android:color/transparent" android:contentDescription="Abrir menú lateral"
                            android:padding="9dp" android:src="@drawable/ic_menu" app:tint="@color/white" />
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:gravity="center" android:text="MANOS SOLIDARIAS" android:textColor="#DDF7F2"
                            android:textSize="12sp" android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btnPerfil" android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@android:color/transparent" android:contentDescription="Mi perfil"
                            android:padding="9dp" android:src="@drawable/ic_perfil" app:tint="@color/white" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/txtSaludo" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:text="Hola, amigo solidario"
                        android:textColor="@color/white" android:textSize="31sp" android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                        android:text="Tu ayuda transforma vidas" android:textColor="@color/white" android:textSize="18sp" />
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                        android:gravity="end|center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Cada objeto puede iniciar una nueva historia." android:textColor="#DDF7F2" android:textSize="12sp" />
                        <ImageView android:layout_width="58dp" android:layout_height="58dp" android:contentDescription="Corazón solidario"
                            android:src="@drawable/manos_solidarias_mark" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="30dp">
                    <Button
                        android:id="@+id/btnDonar" android:layout_width="match_parent" android:layout_height="64dp"
                        android:background="@drawable/bg_coral_button" android:backgroundTint="@null"
                        android:drawableStart="@drawable/ic_heart_outline" android:drawablePadding="12dp"
                        android:elevation="3dp" android:text="Hacer una donación" android:textAllCaps="false"
                        android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
                    <Button
                        android:id="@+id/btnHistorial" android:layout_width="match_parent" android:layout_height="60dp"
                        android:layout_marginTop="14dp" android:background="@drawable/bg_surface_soft" android:backgroundTint="@null"
                        android:gravity="center" android:text="♡   Revisa el impacto de tus donaciones   →"
                        android:textAllCaps="false" android:textColor="@color/sh_primary_dark" android:textStyle="bold" />
                    <Button
                        android:id="@+id/btnNecesidades"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_coral_soft"
                        android:backgroundTint="@null"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="18dp"
                        android:text="✦   Ver necesidades urgentes   →"
                        android:textAllCaps="false"
                        android:textColor="@color/sh_coral_dark"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                        android:text="Fundaciones cerca de ti" android:textColor="@color/text_primary"
                        android:textSize="22sp" android:textStyle="bold" />
                    <EditText
                        android:id="@+id/edtBuscar" android:layout_width="match_parent" android:layout_height="54dp"
                        android:layout_marginTop="12dp" android:background="@drawable/bg_input"
                        android:drawableStart="@android:drawable/ic_menu_search" android:drawablePadding="10dp"
                        android:hint="Buscar fundaciones" android:inputType="text" android:paddingHorizontal="16dp"
                        android:singleLine="true" android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" android:textSize="14sp" />
                    <ProgressBar
                        android:id="@+id/progresoFundaciones" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal" android:layout_marginVertical="20dp"
                        android:indeterminateTint="@color/sh_primary" android:visibility="gone" />
                    <TextView
                        android:id="@+id/txtSinFundaciones" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginVertical="20dp" android:gravity="center" android:text="No se encontraron fundaciones."
                        android:textColor="@color/text_secondary" android:textSize="14sp" android:visibility="gone" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerFundaciones" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:clipToPadding="false" android:orientation="horizontal" android:paddingEnd="8dp" />
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                        android:layout_marginBottom="12dp" android:text="Historias que inspiran"
                        android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="128dp" android:orientation="horizontal">
                        <ImageView android:id="@+id/video1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_surface_soft" android:contentDescription="Historia uno" android:padding="27dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_media_play" app:tint="@color/sh_primary" />
                        <ImageView android:id="@+id/video2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="5dp" android:layout_weight="1" android:background="@drawable/bg_coral_soft" android:contentDescription="Historia dos" android:padding="27dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_media_play" app:tint="@color/sh_coral_dark" />
                        <ImageView android:id="@+id/video3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_surface_soft" android:contentDescription="Historia tres" android:padding="27dp" android:scaleType="centerCrop" android:src="@android:drawable/ic_media_play" app:tint="@color/sh_primary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/homeBottomNav"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="78dp" android:background="@drawable/bg_nav"
            android:elevation="12dp" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="10dp" android:paddingTop="5dp">
            <TextView android:id="@+id/btnNavInicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableTop="@drawable/ic_inicio" android:gravity="center" android:text="Inicio" android:textColor="@color/sh_primary_dark" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/btnNavDonar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableTop="@drawable/ic_foundations" android:gravity="center" android:text="Donar" android:textColor="@color/text_secondary" android:textSize="11sp" />
            <TextView android:id="@+id/btnNavHistorial" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableTop="@android:drawable/ic_menu_recent_history" android:gravity="center" android:text="Historial" android:textColor="@color/text_secondary" android:textSize="11sp" />
            <TextView android:id="@+id/btnNavPerfil" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableTop="@drawable/ic_perfil" android:gravity="center" android:text="Perfil" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView" android:layout_width="300dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:background="@color/white" app:headerLayout="@layout/drawer_header"
        android:fitsSystemWindows="true"
        app:itemIconTint="@color/sh_primary" app:itemTextColor="@color/text_primary" app:menu="@menu/drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
