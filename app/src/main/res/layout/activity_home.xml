<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8F6">

    <!-- CONTENIDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/ic_menu"
                    android:background="@android:color/transparent"
                    app:tint="#287A5A"
                    android:contentDescription="Abrir menú"/>

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="left"
                    android:text="Solidaryhands"
                    android:textColor="#287A5A"
                    android:textSize="25sp"
                    android:textStyle="bold" />
                <!-- BUSCADOR -->
                <EditText
                    android:id="@+id/edtBuscar"
                    android:layout_width="95dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input"
                    android:hint="Buscar"
                    android:paddingStart="10dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="text"/>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#287A5A"
                    android:contentDescription="Buscar"/>


                <ImageButton
                    android:id="@+id/btnPerfil"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginLeft="0sp"
                    android:src="@drawable/ic_claroscuro"
                    android:background="@android:color/transparent"
                    android:tint="#287A5A"
                    android:contentDescription="Mi perfil"/>

            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hola, Carlos "
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#287A5A"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido a la solidaryhands juntos podemos ayudar  "
                android:textSize="15sp"
                android:textStyle="italic"
                android:textColor="#287A5A"/>

            <!-- BOTONES DONAR E HISTORIAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">

                <Button
                    android:id="@+id/btnDonar"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Donar"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"/>

                <Button
                    android:id="@+id/btnHistorial"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Ver historial"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_input"
                    android:backgroundTint="@color/sh_primary"/>

            </LinearLayout>

            <!-- TITULO FUNDACIONES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conociendo fundaciones"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#263C50"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"/>


            <!-- CARRUSEL DE FUNDACIONES -->
            <HorizontalScrollView
                android:id="@+id/carruselFundaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- FUNDACION ALALAY -->
                    <LinearLayout
                        android:id="@+id/cardAlalay"
                        android:layout_width="245dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card"
                        android:elevation="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:background="#E4F1E9"
                            android:contentDescription="Logo Fundación Alalay"
                            android:padding="35dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:tint="#287A5A" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fundación Alalay"
                            android:textColor="#287A5A"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="65dp"
                            android:text="Atención a niños, adolescentes y familias."
                            android:textColor="#52645A"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ver fundación →"
                            android:textColor="#287A5A"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- FUNDACION PALLINI -->
                    <LinearLayout
                        android:id="@+id/cardPallini"
                        android:layout_width="245dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card"
                        android:elevation="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:background="#E4F1E9"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:tint="#287A5A"
                            android:padding="35dp"
                            android:contentDescription="Logo Fundación Pallini"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fundación Pallini"
                            android:textColor="#287A5A"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="65dp"
                            android:text="Programas y actividades de apoyo."
                            android:textColor="#52645A"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ver fundación →"
                            android:textColor="#287A5A"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- WORLD VISION BOLIVIA -->
                    <LinearLayout
                        android:id="@+id/cardWorldVision"
                        android:layout_width="245dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card"
                        android:elevation="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:background="#E4F1E9"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:tint="#287A5A"
                            android:padding="35dp"
                            android:contentDescription="Logo World Vision Bolivia"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="World Vision Bolivia"
                            android:textColor="#287A5A"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="65dp"
                            android:text="Programas de salud, saneamiento, educación y protección de la niñez."
                            android:textColor="#52645A"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ver fundación →"
                            android:textColor="#287A5A"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>


            <!-- VIDEOS CORTOS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Videos cortos"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#263C50"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/video1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_avatar"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="#287A5A"
                    android:padding="25dp"
                    android:contentDescription="Video uno"/>

                <ImageView
                    android:id="@+id/video2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_avatar"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="#287A5A"
                    android:padding="25dp"
                    android:contentDescription="Video dos"/>

                <ImageView
                    android:id="@+id/video3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_avatar"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="#287A5A"
                    android:padding="25dp"
                    android:contentDescription="Video tres"/>

            </LinearLayout>

            <!-- ESPACIO INFERIOR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text="Gracias por ser parte del cambio."
                android:textColor="#718096"
                android:textSize="12sp"
                android:gravity="center"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
