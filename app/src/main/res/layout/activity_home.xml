<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F8F6">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- ENCABEZADO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnMenu"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_menu"
                        android:background="@android:color/transparent"
                        app:tint="@color/sh_primary"
                        android:contentDescription="Abrir menú lateral"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="Solidaryhands"
                        android:textColor="@color/sh_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                    <!-- BUSCADOR -->
                    <EditText
                        android:id="@+id/edtBuscar"
                        android:layout_width="110dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_input"
                        android:hint="Buscar"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:inputType="text"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/sh_primary"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Buscar"/>

                    <ImageButton
                        android:id="@+id/btnPerfil"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_perfil"
                        android:background="@android:color/transparent"
                        app:tint="@color/sh_primary"
                        android:contentDescription="Mi perfil"/>

                </LinearLayout>

                <!-- SALUDO AL USUARIO -->
                <TextView
                    android:id="@+id/txtSaludo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hola, Usuario"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/sh_primary"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido a Solidaryhands, juntos podemos ayudar."
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@color/sh_primary"
                    android:layout_marginTop="2dp"/>

                <!-- BOTONES DONAR E HISTORIAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">

                    <Button
                        android:id="@+id/btnDonar"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Donar"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_button"
                        android:backgroundTint="@null"/>

                    <Button
                        android:id="@+id/btnHistorial"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Ver historial"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_input"
                        android:backgroundTint="@color/sh_primary"/>

                </LinearLayout>

                <!-- TITULO SECCIÓN FUNDACIONES -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Conociendo fundaciones"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#263C50"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp"/>

                <!-- INDICADOR DE CARGA Y ESTADO VACÍO -->
                <ProgressBar
                    android:id="@+id/progresoFundaciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:indeterminateTint="#287A5A"
                    android:visibility="gone"
                    android:layout_marginVertical="20dp"/>

                <TextView
                    android:id="@+id/txtSinFundaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No se encontraron fundaciones."
                    android:textColor="#718096"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginVertical="20dp"/>

                <!-- CARRUSEL DINÁMICO DE FUNDACIONES (RECYCLERVIEW) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerFundaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:paddingEnd="8dp" />

                <!-- VIDEOS CORTOS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Videos cortos"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#263C50"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/video1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_avatar"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="@color/sh_primary"
                        android:padding="25dp"
                        android:contentDescription="Video uno"/>

                    <ImageView
                        android:id="@+id/video2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_avatar"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="@color/sh_primary"
                        android:padding="25dp"
                        android:contentDescription="Video dos"/>

                    <ImageView
                        android:id="@+id/video3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_avatar"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="@color/sh_primary"
                        android:padding="25dp"
                        android:contentDescription="Video tres"/>

                </LinearLayout>

                <!-- ESPACIO INFERIOR -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Gracias por ser parte del cambio."
                    android:textColor="#718096"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- MENU LATERAL (NAVIGATION DRAWER) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="#287A5A"
        app:itemTextColor="#263C50"/>

</androidx.drawerlayout.widget.DrawerLayout>
