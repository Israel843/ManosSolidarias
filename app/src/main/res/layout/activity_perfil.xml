<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8F6">

    <!-- BARRA SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/sh_primary"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnVolverPerfil"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/white"
            android:contentDescription="Volver"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mi Perfil"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- FOTO / AVATAR DE PERFIL -->
            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imgFotoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="#E4F1E9"
                    android:padding="22dp"
                    android:src="@drawable/ic_perfil"
                    app:tint="@color/sh_primary"
                    android:contentDescription="Foto de perfil del usuario"/>

            </FrameLayout>

            <ProgressBar
                android:id="@+id/progresoPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="#287A5A"
                android:visibility="gone"/>

            <!-- TARJETA DE DATOS DEL USUARIO (SUPABASE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:elevation="3dp">

                <!-- NOMBRE COMPLETO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre Completo"
                    android:textColor="#718096"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtNombreCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando nombre..."
                    android:textColor="#263C50"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="3dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EDF2F7"
                    android:layout_marginVertical="12dp"/>

                <!-- CORREO ELECTRÓNICO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo Electrónico"
                    android:textColor="#718096"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtCorreoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="cargando@correo.com"
                    android:textColor="#263C50"
                    android:textSize="15sp"
                    android:layout_marginTop="3dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EDF2F7"
                    android:layout_marginVertical="12dp"/>

                <!-- TELÉFONO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono / Contacto"
                    android:textColor="#718096"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtTelefonoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin teléfono registrado"
                    android:textColor="#263C50"
                    android:textSize="15sp"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

            <!-- TÍTULO SECCIÓN ACCESOS DIRECTOS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accesos rápidos"
                android:textColor="#263C50"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="12dp"/>

            <!-- SECCIÓN: FUNDACIONES -->
            <LinearLayout
                android:id="@+id/cardSeccionFundaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_foundations"
                    app:tint="@color/sh_primary"
                    android:contentDescription="Icono Fundaciones"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fundaciones Aliadas"
                    android:textColor="#263C50"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➔"
                    android:textColor="#718096"
                    android:textSize="16sp"/>

            </LinearLayout>

            <!-- SECCIÓN: HISTORIAL DE DONACIONES -->
            <LinearLayout
                android:id="@+id/cardSeccionHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="@color/sh_primary"
                    android:contentDescription="Icono Historial"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Historial de Donaciones"
                    android:textColor="#263C50"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➔"
                    android:textColor="#718096"
                    android:textSize="16sp"/>

            </LinearLayout>

            <!-- SECCIÓN: CONFIGURACIÓN -->
            <LinearLayout
                android:id="@+id/cardSeccionConfiguracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="@color/sh_primary"
                    android:contentDescription="Icono Configuración"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Configuración de la Cuenta"
                    android:textColor="#263C50"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➔"
                    android:textColor="#718096"
                    android:textSize="16sp"/>

            </LinearLayout>

            <!-- BOTÓN CERRAR SESIÓN -->
            <Button
                android:id="@+id/btnCerrarSesionPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input"
                android:backgroundTint="#F8D7DA"
                android:text="Cerrar Sesión"
                android:textColor="#721C24"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textAllCaps="false"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
