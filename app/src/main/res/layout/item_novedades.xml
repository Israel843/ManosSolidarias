<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card"
    android:elevation="3dp">

    <!-- IMAGEN DE LA PUBLICACION -->
    <ImageView
        android:id="@+id/imgNovedad"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:scaleType="centerCrop"
        android:background="#E4F2EA"
        android:src="@android:drawable/ic_menu_gallery"
        android:contentDescription="Imagen de la publicación"/>

    <!-- CATEGORIA -->
    <TextView
        android:id="@+id/txtCategoriaNovedad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EDUCACION"
        android:textColor="#287A5A"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"/>

    <!-- TITULO -->
    <TextView
        android:id="@+id/txtTituloNovedad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Educación para todos"
        android:textColor="#263C50"
        android:textSize="19sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"/>

    <!-- FECHA -->
    <TextView
        android:id="@+id/txtFechaNovedad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="9 de noviembre de 2026"
        android:textColor="#718096"
        android:textSize="11sp"
        android:layout_marginTop="5dp"/>

    <!-- DESCRIPCION -->
    <TextView
        android:id="@+id/txtDescripcionNovedad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción de la actividad..."
        android:textColor="#52645A"
        android:textSize="14sp"
        android:layout_marginTop="10dp"/>

    <!-- BOTON DETALLES -->
    <Button
        android:id="@+id/btnDetalleNovedad"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Ver publicación"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#287A5A"/>

</LinearLayout>
